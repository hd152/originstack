# Model checkpoints: binary, never diffed or EOL-normalised.
*.pt binary
*.pth binary
*.onnx binary

# Vendored third-party source: keep LF so the tree stays byte-identical to
# upstream (re-synced by copying, not editing -- see vendor/*/VENDORED_FROM.txt).
vendor/** text eol=lf

# Lockfile: committed, keep LF so it doesn't churn between platforms.
ext/astro_native/Cargo.lock text eol=lf

# Shell scripts must keep LF or the shebang line breaks on Linux.
*.sh text eol=lf
packaging/linux/** text eol=lf
