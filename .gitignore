# Test data directories
orion-live/
synthetic_data/
synthetic_data_mixed/

# Claude Code directories
.claude/
**/claude/

# Registration debug output
_registration_debug/

# Python bytecode
*.pyc
*.pyo
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/
packaging/.build_venv/

# FITS and image output files — never publish raw or processed data
*.fits
*.fit
*.jpg
*.jpeg
*.png
*.tif
*.tiff
# Allow sample preview JPEGs used in README
!sample/*.jpg

# Temporary files
*.tmp
*.temp
*.log
*.dat
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor files
.vscode/
.idea/
*.sublime-*
.project
.pydevproject

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints/

# Session data files that may contain PII (GPS coords, observer info, telescope location)
**/info.json
sample/**/*.json

# Generated run artifacts (never source)
# effective-config dump written next to every output (<output>_config.toml)
*_config.toml
# resume checkpoints (raw_stack.npy, transforms.npy, ...)
*_checkpoint/
*.npy
*.xisf

# Native (Rust) build output
ext/**/target/
*.whl
